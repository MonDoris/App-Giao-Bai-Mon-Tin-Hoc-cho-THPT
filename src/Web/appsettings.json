{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "IdleMinutes": 120,
    "AbsoluteHours": 10,
    "LoginRatePerMinute": 60,
    "SubmissionMinIntervalSeconds": 3
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=DKEducation;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  }
}
